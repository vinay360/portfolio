{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker/index.js",
  "build": {
    "command": "npm run build:vinext"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "no_bundle": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
